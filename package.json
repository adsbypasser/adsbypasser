{
  "name": "adsbypasser",
  "version": "8.30.0",
  "description": "A lightweight userscript that automatically skips countdown ads, bypasses continue pages, and prevents ad pop-up windows on many supported sites.",
  "keywords": [
    "userscript",
    "adblock",
    "bypass",
    "skip",
    "countdown",
    "ads",
    "tampermonkey",
    "violentmonkey",
    "greasemonkey"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/adsbypasser/adsbypasser.git"
  },
  "bugs": {
    "url": "https://github.com/adsbypasser/adsbypasser/issues"
  },
  "homepage": "https://adsbypasser.github.io/",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "decomment": "^0.9.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "lodash": "^4.18.1",
    "parse-domain": "^8.2.2",
    "prettier": "^3.0.0",
    "rollup": "^4.59.0",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "build": "node build/make.js userscript",
    "clean": "node build/make.js clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "ghpages": "node build/make.js ghpages",
    "ci:release-notes": "node build/ci/release-notes.js"
  }
}
